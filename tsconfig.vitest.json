{
  "extends": "./tsconfig.app.json",
  "exclude": ["**/node_modules/**", "**/dist/**"],
  "compilerOptions": {
    "composite": false,
    "types": ["node", "jsdom"]
  },
  "include": [
    "typings/**/*.d.ts",
    "packages/**/__tests__/**/*.ts",
    "packages/**/*.spec.ts",
    "packages/**/*.test.ts"
  ]
}
