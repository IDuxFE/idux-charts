{
  "extends": "@vue/tsconfig/tsconfig.lib.json",
  "include": ["./**/*"],
  "compilerOptions": {
    "types": ["node"],
    "skipLibCheck": true,
    "paths": {
      "@idux/charts": ["../packages/charts/index.ts"],
      "@idux/charts-core": ["../packages/core/index.ts"],
