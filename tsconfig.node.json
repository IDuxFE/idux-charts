{
  "extends": "@vue/tsconfig/tsconfig.json",
  "include": [
    "build/**/*.ts",
    "vite.config.*",
    "vitest.config.*",
    "playwright.config.*",
    "e2e/environment.ts",
    "packages/site/deployment.ts",
    "packages/*/vite.config.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "skipLibCheck": true
  }
}
