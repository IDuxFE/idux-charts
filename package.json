{
  "name": "idux-charts",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "check:staged": "lint-staged --concurrent false",
    "preinstall": "npx only-allow pnpm",
    "clean": "pnpm -r --stream --filter=./packages/* run clean && rimraf dist node_modules",
    "start": "pnpm -r --stream --filter=./packages/site run start",
    "build": "run-p build:lib build:site",
    "build:lib": "pnpm -r --stream --filter=!./packages/site run build && pnpm check:declarations",
    "check:declarations": "node scripts/check-declarations.mjs",
    "check": "run-p --continue-on-error lint format:check typecheck test:unit",
    "build:site": "pnpm -r --stream --filter=./packages/site run build",
    "preview": "pnpm --filter @idux/charts-site exec vite preview --outDir dist",
    "test": "run-p test:unit test:e2e test:playgrounds",
    "test:unit": "vitest run",
    "test:declarations": "node --experimental-strip-types scripts/test-declarations.mjs",
    "test:e2e": "playwright test",
    "benchmark:charts": "node scripts/benchmark-charts.mjs",
    "test:playgrounds": "run-s playgrounds:prepare test:playgrounds:run",
    "test:playgrounds:run": "run-p test:playground:vue2 test:playground:vue3",
    "test:playground:vue2": "pnpm --dir playgrounds/vue2 test:e2e",
    "test:playground:vue3": "pnpm --dir playgrounds/vue3 test:e2e",
    "playgrounds:prepare": "node scripts/prepare-playgrounds.mjs",
    "typecheck": "vue-tsc --build --noEmit",
    "lint": "oxlint . --deny-warnings",
    "lint:fix": "oxlint . --fix --deny-warnings",
    "format": "oxfmt . --write",
    "format:check": "oxfmt . --check",
    "changelog": "pnpm changeset",
    "version": "pnpm changeset version",
    "version:release": "pnpm run version && pnpm install --no-lockfile --no-frozen-lockfile",
    "publish": "pnpm changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@idux/cdk": "^2.11.0",
    "@idux/components": "^2.11.0",
    "@idux/pro": "^2.11.0",
    "@playwright/test": "1.64.1",
    "@types/jsdom": "^28.0.3",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^22.14.0",
    "@types/pngjs": "^6.0.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "canvas": "^3.2.3",
    "echarts": "^6.1.0",
    "husky": "^9.1.7",
    "jsdom": "~28.1.0",
    "less": "^4.9.1",
    "lint-staged": "^16.4.0",
    "npm-run-all": "^4.1.5",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.89.0",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vite-plugin-dts": "^5.0.2",
    "vitest": "^5.0.5",
    "vue": "^3.5.44",
    "vue-tsc": "^3.3.13"
  },
  "engines": {
    "pnpm": ">=10",
    "node": "^22.14.0 || ^24.0.0 || >=26.0.0"
  },
  "type": "module"
}
