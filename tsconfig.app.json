{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": ["typings/**/*.d.ts", "packages/**/*.ts", "packages/**/*.tsx", "packages/**/*.vue"],
  "exclude": [
    "**/node_modules/**",
    "**/dist/**",
    "packages/**/__tests__/**",
    "packages/**/*.spec.*",
    "packages/**/*.test.*",
    "packages/**/vite.config.*",
    "packages/site/deployment.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "paths": {
      "@idux/charts": ["./packages/charts/index.ts"],
      "@idux/charts-plots/dist/*": ["./packages/plots/*"]
    },
    "lib": ["ES2020", "DOM", "DOM.Iterable"]
  }
}
