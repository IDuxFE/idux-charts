{
  "name": "@idux/charts",
  "version": "1.4.0",
  "description": "A chart component library for Vue 2 & 3",
  "keywords": [
    "vue",
    "vue2",
    "vue3",
    "chart",
    "charts"
  ],
  "homepage": "https://github.com/IDuxFE/idux-charts#readme",
  "bugs": {
    "url": "https://github.com/IDuxFE/idux-charts/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/IDuxFE/idux-charts",
    "directory": "packages/charts"
  },
  "license": "MIT",
  "author": "IDuxFE<idux.feteam@gmail.com>",
  "type": "module",
  "main": "./dist/index.umd.cjs",
  "module": "./dist/index.js",
  "typings": "./dist/index.d.ts",
  "unpkg": "./dist/index.umd.cjs",
  "jsdelivr": "./dist/index.umd.cjs",
  "files": [
    "dist",
    "*.md",
    "*.d.ts"
  ],
  "sideEffects": [
    "**/*.css",
    "**/*.less"
  ],
  "scripts": {
    "clean": "rimraf dist node_modules",
    "build": "rimraf dist && vite build && vite build --mode modular"
  },
  "dependencies": {
    "@idux/charts-core": "workspace:*",
    "@idux/charts-plots": "workspace:*"
  },
  "peerDependencies": {
    "@vue/composition-api": ">=1.6.2",
    "echarts": "^5.4.3 || ^6.0.0",
    "lodash-es": "^4.17.0",
    "vue": "^2.6.0 || ^3.2.5"
  },
  "peerDependenciesMeta": {
    "@vue/composition-api": {
      "optional": true
    }
  },
  "devDependencies": {
    "echarts": "^6.1.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.umd.cjs"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./bar": {
      "types": "./dist/bar.d.ts",
      "import": "./dist/bar.js"
    },
    "./line": {
      "types": "./dist/line.d.ts",
      "import": "./dist/line.js"
    },
    "./pie": {
      "types": "./dist/pie.d.ts",
      "import": "./dist/pie.js"
    },
    "./radar": {
      "types": "./dist/radar.d.ts",
      "import": "./dist/radar.js"
    },
    "./gauge": {
      "types": "./dist/gauge.d.ts",
      "import": "./dist/gauge.js"
    },
    "./liquid-fill": {
      "types": "./dist/liquid-fill.d.ts",
      "import": "./dist/liquid-fill.js"
    },
    "./types": {
      "types": "./types.d.ts"
    },
    "./types.d.ts": "./types.d.ts",
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "core": [
        "dist/core.d.ts"
      ],
      "bar": [
        "dist/bar.d.ts"
      ],
      "line": [
        "dist/line.d.ts"
      ],
      "pie": [
        "dist/pie.d.ts"
      ],
      "radar": [
        "dist/radar.d.ts"
      ],
      "gauge": [
        "dist/gauge.d.ts"
      ],
      "liquid-fill": [
        "dist/liquid-fill.d.ts"
      ]
    }
  }
}
