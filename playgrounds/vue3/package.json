{
  "name": "@idux/charts-playground-vue3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots"
  },
  "dependencies": {
    "@idux/charts": "file:vendor/idux-charts.tgz",
    "@idux/charts-core": "file:vendor/idux-charts-core.tgz",
    "@idux/charts-plots": "file:vendor/idux-charts-plots.tgz",
    "echarts": "6.0.0",
    "lodash-es": "4.17.21",
    "vue": "3.5.44"
  },
  "devDependencies": {
    "vite": "8.3.5",
    "@playwright/test": "1.64.1"
  },
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=9"
  },
  "pnpm": {
    "overrides": {
      "@idux/charts>@idux/charts-core": "file:vendor/idux-charts-core.tgz",
      "@idux/charts>@idux/charts-plots": "file:vendor/idux-charts-plots.tgz",
      "@idux/charts-plots>@idux/charts-core": "file:vendor/idux-charts-core.tgz"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "vue-demi"
    ]
  }
}
